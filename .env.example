# Copy this file to ".env" and fill in the SANDBOX credentials of your
# PayPal REST app (PayPal Developer Dashboard -> Apps & Credentials ->
# Sandbox -> your app, e.g. "VetoPay").
#
# NEVER commit the real .env file. NEVER use Live credentials for the demo.
#
# If .env is missing or the credentials are empty, VetoPay runs in MOCK
# mode: a built-in fake transport that mimics the official PayPal MCP
# tool surface, so all scenarios run end-to-end with zero credentials.

# mock | real   (default: mock unless both credentials below are set)
VETOPAY_MODE=mock

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox API base (used for the OAuth token exchange and the REST fallback)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Veto layer tuning (optional)
# Max amount (USD) the agent may move without human approval:
VETOPAY_AUTO_APPROVE_LIMIT=100
# Comma-separated recipients the agent already knows / trusts:
VETOPAY_KNOWN_RECIPIENTS=test-buyer@example.com,vendor@acme-supplies.example
